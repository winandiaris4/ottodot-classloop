# ==============================================================================
# ClassLoop — Production Environment Variables (VPS / Docker)
# ==============================================================================
# Salin file ini menjadi .env.production di VPS: cp .env.production.example .env.production
# PENTING: Jangan tambahkan komentar di samping nilai variabel (inline comments)
# ==============================================================================

# ------------------------------------------------------------------------------
# PORT HOSTING (Sesuaikan jika port 3000 sudah dipakai aplikasi lain seperti dockhand)
# ------------------------------------------------------------------------------
APP_PORT=3060

# ------------------------------------------------------------------------------
# SUPABASE CONFIG
# Dapatkan dari: Supabase Cloud Dashboard → Project Settings → API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# STRIPE PAYMENTS (Gunakan key live atau test mode)
# Dapatkan dari: Stripe Dashboard → Developers → API Keys / Webhooks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ------------------------------------------------------------------------------
# RESEND (Email Transaksional)
# Dapatkan dari: Resend Dashboard → API Keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# APP URL (PENTING: Ditanam saat build Next.js)
# Jika menggunakan reverse proxy domain: https://classloop.yourdomain.com
# Jika menggunakan IP langsung: http://YOUR_SERVER_IP:3060
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://classloop.yourdomain.com
